# Copy to `.env` (gitignored) at the repo root and fill in.

# Upstash Redis REST — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional namespace prepended to every key, so several apps can share one DB.
REDIS_KEY_PREFIX=

# Optional: Discord application. Enables "Sign in with Discord" on the website
# (register `{PUBLIC_BASE_URL}/` under OAuth2 -> Redirects) and, in apps built
# with the `discord-activity` feature, activity sign-in. Set both or neither;
# leave both unset to disable Discord login. Requires PUBLIC_BASE_URL.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email (magic-link) login. With RESEND_API_KEY set, emails are sent via
# Resend (RESEND_FROM_EMAIL required). Without it, DEV_MODE=1 prints the login
# link to the console instead. With neither, email login is disabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEV_MODE=
# Origin users reach the site at (the emailed login link and the Discord
# redirect are built from it); required when email or Discord login is enabled.
PUBLIC_BASE_URL=http://localhost:8080
# Shown in the login email subject. Defaults to "webapp".
APP_NAME=

# Example server: directory of the trunk-built client (default build/dist).
STATIC_DIR=
